# Dashboard dev server 环境变量模板
#
# 复制为 dashboard/.env.local 并按自己的部署填写（.env.local 已被 .gitignore 的 *.local 规则忽略）。
# 真实服务器地址不要写进仓库。

# npm run dev 时 /api 代理的目标（云端千惠 WebUI）。
# - 走 SSH 隧道（start_amadeus.ps1 会把云端 8001 映射到本机 18001）：
#     MAIBOT_CLOUD_WEBUI_URL=http://127.0.0.1:18001
# - 直连云端：
#     MAIBOT_CLOUD_WEBUI_URL=http://<云端主机>:8001
# - 不设置时回退为 http://127.0.0.1:8001
MAIBOT_CLOUD_WEBUI_URL=http://127.0.0.1:18001

# 允许访问 dev server 的额外主机名，逗号分隔（例如 Tailscale / 内网域名）。
# 不设置时只有 127.0.0.1 与 localhost 可访问。
# MAIBOT_DASHBOARD_ALLOWED_HOSTS=your-machine.your-tailnet.ts.net
